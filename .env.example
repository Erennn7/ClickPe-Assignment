# ==============================================================================
# The Loan Eligibility Engine - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loan_engine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loan_engine
# Internal Docker URL used by n8n to connect to postgres container
DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/loan_engine

# n8n Automation Engine
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_BASIC_AUTH_ACTIVE=false
WEBHOOK_URL=http://localhost:5678/
N8N_MATCHING_WEBHOOK_PATH=/webhook/matching-trigger

# AWS Configuration (Local or Cloud)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=clickpe-loan-engine-user-uploads

# Amazon SES / Notification Settings
SES_FROM_EMAIL=
SES_TEST_RECIPIENT_EMAIL=

# LLM Providers for Workflow A (Crawler) & Workflow B (Reasoning)
GROQ_API_KEY=
GEMINI_API_KEY=
